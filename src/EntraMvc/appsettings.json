{
  // TenantId/ClientId/CallbackPath come from env or user-secrets; ClientSecret ONLY from secrets, never here.
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "CallbackPath": "/signin-oidc",
    "ResponseType": "code" // auth-code flow redeemed with ClientSecret
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
